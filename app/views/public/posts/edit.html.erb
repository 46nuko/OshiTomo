<h1>編集画面</h1>
<% if @post.errors.any? %>
  <%= @post.errors.count %>件のエラーが発生しました
  <ul>
    <% @post.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>
<%= form_with model: @post do |f| %>
  <p><%= f.file_field :image, accept: "image/*" %></P>
  <p><%= f.text_area :body %></p>
  <%= f.submit '保存' %>
  
<% end %>